# docs/ is auto-generated by prepare-docs (bin/build.js), but these static
# files are created by the Zensical scaffold only when zensical.toml is
# absent. The deploy pod skips the scaffold (zensical.toml is tracked), so
# they must be committed to survive a rebuild.
docs/*
!docs/assets/
docs/assets/*
!docs/assets/icon.png
!docs/assets/icon.svg
!docs/javascripts/
docs/javascripts/*
!docs/javascripts/extra.js
!docs/stylesheets/
docs/stylesheets/*
!docs/stylesheets/style.css
